{
  "files.exclude": {
    ".contextory-local": true
  },
  "files.watcherExclude": {
    "**/.contextory-local/**": true
  },
  "search.exclude": {
    "**/.contextory-local/**": true
  },
  "contextory.checks": [
    {
      "id": "embedded-documentation",
      "name": "Bundled documentation runtime, provenance, source maintenance and Carbon site",
      "executable": "node",
      "args": ["--import", "tsx", "--test", "--test-concurrency=2", "tests/integration/documentation.test.ts", "tests/documentation/embedded.test.mjs"],
      "timeoutMs": 180000
    },
    {
      "id": "codebase",
      "name": "Codebase graph and freshness integration",
      "executable": "node",
      "args": [
        "--import",
        "tsx",
        "--test",
        "tests/integration/codebase.test.ts"
      ],
      "timeoutMs": 180000
    },
    {
      "id": "retrieval",
      "name": "Source and project-memory retrieval",
      "executable": "node",
      "args": [
        "--import",
        "tsx",
        "--test",
        "tests/integration/codebase.test.ts",
        "tests/integration/knowledge.test.ts"
      ],
      "timeoutMs": 180000
    },
    {
      "id": "portability",
      "name": "Native and headless client contracts",
      "executable": "node",
      "args": [
        "--import",
        "tsx",
        "--test",
        "tests/integration/headless.test.ts",
        "tests/integration/registration.test.ts",
        "tests/integration/service.test.ts"
      ],
      "timeoutMs": 180000
    },
    {
      "id": "architecture-ui",
      "name": "Architecture UI and state regression",
      "executable": "node",
      "args": [
        "node_modules/@playwright/test/cli.js",
        "test",
        "tests/ui/architecture.spec.ts"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "codebase-evaluation",
      "name": "Deterministic retrieval and graph evaluation",
      "executable": "node",
      "args": [
        "--import",
        "tsx",
        "scripts/evaluate-codebase.ts",
        "--stdout"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "portable-skills",
      "name": "Canonical skill drift",
      "executable": "node",
      "args": [
        "scripts/package-skills.mjs",
        "--check"
      ],
      "timeoutMs": 30000
    },
    {
      "id": "workspace-skills",
      "name": "Installed client skill drift",
      "executable": "node",
      "args": [
        "--import",
        "tsx",
        "scripts/sync-workspace-skills.ts",
        "--check"
      ],
      "timeoutMs": 30000
    },
    {
      "id": "typecheck",
      "name": "TypeScript typecheck",
      "executable": "node",
      "args": [
        "node_modules/typescript/bin/tsc",
        "--noEmit"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "tests",
      "name": "Core, integration and analysis tests",
      "executable": "node",
      "args": [
        "--import",
        "tsx",
        "--test",
        "--test-concurrency=2",
        "tests/core/*.test.ts",
        "tests/integration/*.test.ts",
        "tests/analysis/*.test.ts"
      ],
      "timeoutMs": 600000
    },
    {
      "id": "documentation",
      "name": "Complete documentation build and link validation",
      "executable": "node",
      "args": [
        "scripts/docs.mjs"
      ],
      "timeoutMs": 180000
    },
    {
      "id": "visual-exploration",
      "name": "Visual exploration navigation and UI regression",
      "executable": "node",
      "args": [
        "node_modules/@playwright/test/cli.js",
        "test"
      ],
      "timeoutMs": 180000
    },
    {
      "id": "release-publication",
      "name": "Published release assets, orphan branch and full Pages documentation",
      "executable": "node",
      "args": [
        "scripts/verify-release.mjs"
      ],
      "timeoutMs": 180000
    },
    {
      "id": "native-recovery",
      "name": "Native recovery and persisted setup restart regressions",
      "executable": "node",
      "args": [
        "--import",
        "tsx",
        "--test",
        "tests/core/reload.test.ts",
        "tests/integration/service.test.ts",
        "tests/integration/registration.test.ts"
      ],
      "timeoutMs": 180000
    },
    {
      "id": "source-snapshot",
      "name": "Complete streamed source fingerprints and runner outcomes",
      "executable": "node",
      "args": [
        "--import",
        "tsx",
        "--test",
        "tests/integration/source-snapshot.test.ts"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "background-startup",
      "name": "Actual hidden-sidebar automatic activation, readiness recovery and paused startup",
      "executable": "node",
      "args": ["scripts/verify-background-startup.mjs"],
      "timeoutMs": 300000
    },
    {
      "id": "knowledge-review",
      "name": "Approval policy, enforced waiting and knowledge review boundaries",
      "executable": "node",
      "args": [
        "--import",
        "tsx",
        "--test",
        "--test-concurrency=2",
        "tests/integration/approval-policy.test.ts",
        "tests/core/workflow.test.ts",
        "tests/core/i18n.test.ts",
        "tests/core/history.test.ts",
        "tests/integration/i18n.test.ts",
        "tests/integration/catalog.test.ts",
        "tests/integration/service.test.ts",
        "tests/integration/headless.test.ts",
        "tests/integration/registration.test.ts"
      ],
      "timeoutMs": 180000
    },
    {
      "id": "localization",
      "name": "English and Brazilian Portuguese UI catalog and manifest coverage",
      "executable": "node",
      "args": ["scripts/check-localization.mjs"],
      "timeoutMs": 30000
    }
  ]
}
