      "path": "scripts/documentation/build.py",
      "sha256": "4ab2886fcc1cc1c7db83293b19720be006dbbeb4f99a7b47b411bc640eee014d",
      "language": "python",
      "symbols": [
        {
          "name": "<module>",
          "kind": "module",
          "line": 1,
          "endLine": 262,
          "docstring": "PT-BR: Gera os guias com o runtime e os layouts padrão da skill de documentação.\n\nEN: Build guides with the documentation skill's unchanged runtime and default layouts.",
          "signature": "scripts/documentation/build.py"
        },
        {
          "name": "Links",
          "kind": "class",
          "line": 26,
          "endLine": 47,
          "signature": "class Links(HTMLParser)",
          "docstring": "PT-BR: Coleta destinos locais e âncoras para verificar o HTML gerado.\n\nEN: Collect local destinations and anchors to verify generated HTML."
        },
        {
          "name": "Links.__init__",
          "kind": "method",
          "line": 32,
          "endLine": 36,
          "signature": "__init__(self)",
          "docstring": "PT-BR: Inicia coleções por página. EN: Initialize per-page collections."
        },
        {
          "name": "Links.handle_starttag",
          "kind": "method",
          "line": 38,
          "endLine": 47,
          "signature": "handle_starttag(self, tag, attrs)",
          "docstring": "PT-BR: Registra links e IDs sem executar scripts. EN: Record links and IDs without running scripts."
        },
        {
          "name": "write_managed",
          "kind": "function",
          "line": 50,
          "endLine": 59,
          "signature": "write_managed(site, relative, content)",
          "docstring": "PT-BR: Grava um artefato dentro do site e devolve seu hash de bytes.\n\nEN: Write an artifact inside the site and return its byte hash."
        },
        {
          "name": "verify_vendor",
          "kind": "function",
          "line": 62,
          "endLine": 70,
          "signature": "verify_vendor()",
          "docstring": "PT-BR: Recusa alterações no runtime e nos layouts padrão copiados da skill.\n\nEN: Refuse changes to the runtime and default layouts copied from the skill."
        },
        {
          "name": "root_landing",
          "kind": "function",
          "line": 73,
          "endLine": 88,
          "signature": "root_landing(name)",
          "docstring": "PT-BR: Encaminhar a raiz do site para o guia padrão sem oferecer uma escolha de idioma.\n\nEN: Send the site root to the default guide without presenting a language choice."
        },
        {
          "name": "compatibility",
          "kind": "function",
          "line": 91,
          "endLine": 125,
          "signature": "compatibility()",
          "docstring": "PT-BR: Preserva URLs e arquivos legados sem alterar o shell Carbon padrão.\n\nEN: Preserve legacy URLs and files without changing the default Carbon shell."
        },
        {
          "name": "check_links",
          "kind": "function",
          "line": 128,
          "endLine": 156,
          "signature": "check_links()",
          "docstring": "PT-BR: Confere páginas, imagens, exports e âncoras locais com o site já gerado.\n\nEN: Check pages, images, exports and local anchors in the completed site."
        },
        {
          "name": "export_markdown",
          "kind": "function",
          "line": 159,
          "endLine": 195,
          "signature": "export_markdown()",
          "docstring": "PT-BR: Atualiza apenas guias explicitamente gerenciados e preserva os originais no arquivo.\n\nEN: Update only explicitly managed guides while preserving originals in the archive."
        },
        {
          "name": "export_markdown.repository_link",
          "kind": "function",
          "line": 174,
          "endLine": 185,
          "signature": "repository_link(match)",
          "docstring": "PT-BR: Ajusta links do export para o caminho do guia no repositório.\n\nEN: Adjust export links for the guide's repository location."
        },
        {
          "name": "consumer_bundle",
          "kind": "function",
          "line": 198,
          "endLine": 218,
          "signature": "consumer_bundle()",
          "docstring": "PT-BR: Gera o bundle de consulta e inclui a licença MIT do runtime distribuído.\n\nEN: Generate the query bundle and include the distributed runtime's MIT license."
        },
        {
          "name": "main",
          "kind": "function",
          "line": 221,
          "endLine": 258,
          "signature": "main()",
          "docstring": "PT-BR: Executa mapa/validação/build/export/preview sem publicar nem aprovar fontes.\n\nEN: Run mapping/validation/build/export/preview without publishing or approving sources."
        }
