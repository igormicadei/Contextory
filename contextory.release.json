{
  "schemaVersion": 1,
  "branch": "main",
  "remote": "origin",
  "versionFiles": [
    { "path": "package.json", "format": "json", "keys": [["version"]] },
    {
      "path": "package-lock.json",
      "format": "json",
      "keys": [["version"], ["packages", "", "version"]]
