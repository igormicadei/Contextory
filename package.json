{
  "name": "contextory-workspace",
  "displayName": "Contextory - Requests & Agent Context",
  "description": "Manage requests, milestones and specs. Give native agents shared context through decisions, evidence, workspace search and code flow.",
  "version": "0.9.0",
  "publisher": "contextory-local",
  "icon": "media/contextory-icon.png",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/igormicadei/Contextory.git"
  },
  "homepage": "https://github.com/igormicadei/Contextory#readme",
  "bugs": {
    "url": "https://github.com/igormicadei/Contextory/issues"
  },
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=24.0.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:contextory.tasks",
    "*"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The sidebar opens read-only; connecting agents, source analysis and checks require a trusted local workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextory",
          "title": "Contextory",
          "icon": "media/contextory.svg"
        }
      ]
    },
    "views": {
      "contextory": [
        {
          "type": "webview",
          "id": "contextory.tasks",
          "name": "Workspace Tasks",
          "contextualTitle": "Contextory"
        }
      ]
    },
    "commands": [
      {
        "command": "contextory.restartAgentExtensions",
        "title": "Contextory: Restart Agent Extensions"
      },
      {
        "command": "contextory.checkConnections",
        "title": "Contextory: Check Native Connections"
      },
      {
        "command": "contextory.rebuildHooks",
        "title": "Contextory: Rebuild Agent Hooks"
      },
      {
        "command": "contextory.connectGenericMcp",
        "title": "Contextory: Export Generic MCP Connection"
      },
      {
        "command": "contextory.openArchitecture",
        "title": "Contextory: Explore Architecture"
      },
      {
        "command": "contextory.toggleAutoConnect",
        "title": "Contextory: Toggle Automatic Agent Connections"
      },
      {
        "command": "contextory.openPlan",
        "title": "Contextory: Open Rebuild Plan"
      },
      {
        "command": "contextory.refresh",
        "title": "Contextory: Refresh Workspace"
      },
      {
        "command": "contextory.connectNativeCodex",
        "title": "Contextory: Connect Native Codex"
      },
      {
        "command": "contextory.connectNativeClaude",
        "title": "Contextory: Connect Native Claude Code"
      },
      {
        "command": "contextory.connectNativeBob",
        "title": "Contextory: Connect Native IBM Bob"
      },
      {
        "command": "contextory.disconnectProvider",
        "title": "Contextory: Disconnect an Agent"
      },
      {
        "command": "contextory.traceFlowFromHere",
        "title": "Contextory: Trace Flow from Here"
      },
      {
        "command": "contextory.prepareSemantic",
        "title": "Contextory: Prepare Local Semantic Search"
      },
      {
        "command": "contextory.indexWorkspace",
        "title": "Contextory: Index Workspace Knowledge"
      },
      {
        "command": "contextory.exportReport",
        "title": "Contextory: Export Implementation Report"
      }
    ],
    "configuration": {
      "title": "Contextory Companion",
      "properties": {
        "contextory.autoConnect": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Prepare native agent connections automatically in trusted local workspaces. Turn off to pause automatic setup; existing connections and project records remain available."
        },
        "contextory.startupAgent": {
          "type": "string",
          "enum": [
            "auto",
            "last-used",
            "codex",
            "claude",
            "bob",
            "none"
          ],
          "enumDescriptions": [
            "Connect every detected native agent: installed Codex/Claude Code extensions and IBM Bob in the Bob editor.",
            "Prepare the last agent used in this workspace, falling back to the last agent used in another workspace.",
            "Prepare the native Codex bridge at startup.",
            "Prepare the native Claude Code bridge at startup.",
            "Prepare the native IBM Bob bridge at startup.",
            "Do not select an agent automatically. Existing connections remain configured."
          ],
          "default": "auto",
          "scope": "resource",
          "description": "Native agent bridges to prepare in a trusted local workspace. Auto detects every installed supported agent and the Bob editor. Native agents own session startup and MCP trust/reload. A manually disconnected agent stays disabled in this workspace until reconnected."
        },
        "contextory.nodeExecutable": {
          "type": "string",
          "default": "node",
          "scope": "machine",
          "description": "Node.js 24+ executable for the isolated workspace service. Native provider executables are not launched by Contextory."
        },
        "contextory.restartAfterSetup": {
          "type": "string",
          "enum": [
            "prompt",
            "automatic",
            "never"
          ],
          "default": "prompt",
          "scope": "resource",
          "description": "Restart the Extension Host after changed native MCP/hooks or bridge runtime: offer once (default), automatically restart, or never offer. Restarting interrupts active extension tasks; native hook trust remains required. Unchanged project openings do not restart."
        },
        "contextory.flowDepth": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 12,
          "scope": "resource",
          "description": "Default call-hop depth for source flow diagrams."
        },
        "contextory.pythonExecutable": {
          "type": "string",
          "default": "python",
          "scope": "machine",
          "description": "Python 3.10+ executable for isolated AST source-flow analysis. Workspace code is parsed, never imported or executed."
        },
        "contextory.checks": {
          "type": "array",
          "maxItems": 256,
          "default": [],
          "scope": "resource",
          "description": "Independent check recipes runnable by connected native agents. Commands execute trusted workspace code. Use executable and argument arrays, without shell fragments.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "executable",
              "args"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              "name": {
                "type": "string"
              },
              "executable": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 1800000
              }
            }
          }
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "contextory.traceFlowFromHere",
          "when": "editorTextFocus",
          "group": "navigation@20"
        }
      ]
    }
  },
  "scripts": {
    "skills:package": "node scripts/package-skills.mjs",
    "skills:check": "node scripts/package-skills.mjs --check",
    "skills:sync": "npm run skills:package && node --import tsx scripts/sync-workspace-skills.ts",
    "skills:workspace-check": "npm run skills:check && node --import tsx scripts/sync-workspace-skills.ts --check",
    "build": "node scripts/build.mjs",
    "icons:render": "node scripts/render-icons.mjs",
    "prepare:debug": "npm run build && node scripts/prepare-debug.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && node scripts/preview.mjs",
    "test": "node --import tsx --test tests/core/*.test.ts tests/integration/*.test.ts tests/analysis/*.test.ts",
    "test:ui": "playwright test",
    "test:host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/host-smoke.ps1",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "evaluate:codebase": "node --import tsx scripts/evaluate-codebase.ts",
    "prepare:semantic": "node scripts/prepare-embeddings.mjs",
    "check": "npm run skills:check && npm run typecheck && npm run build && npm test && npm run test:ui",
    "package:vsix": "npm run docs:build && npm run docs:integrations && npm run build && node scripts/licenses.mjs && node scripts/package-vsix.mjs",
    "format": "prettier --write src tests scripts docs README.md package.json tsconfig.json playwright.config.ts",
    "docs:build": "node scripts/docs.mjs",
    "docs:preview": "node scripts/docs.mjs preview",
    "docs:map": "node scripts/docs.mjs map",
    "docs:migrate": "node scripts/docs.mjs migrate",
    "docs:validate": "node scripts/docs.mjs validate",
    "docs:check": "npm run docs:validate && npm run docs:build && node --test tests/documentation/site.test.mjs",
    "docs:integrations": "node scripts/docs.mjs integrations",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.12",
    "prettier": "3.6.2",
    "tsx": "^4.20.6"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "typescript": "^5.9.3",
    "zod": "4.6.7"
  }
}
