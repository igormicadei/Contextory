{
  "name": "relay-workspace",
  "displayName": "Relay - Native Agent Companion",
  "description": "Shared specs, decisions, evidence, workspace search and source flow alongside native Codex, Claude Code and IBM Bob.",
  "version": "0.2.2",
  "publisher": "relay-local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=24.0.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:relay.tasks",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The sidebar opens read-only; connecting agents, source analysis and checks require a trusted local workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "relay",
          "title": "Relay",
          "icon": "media/relay.svg"
        }
      ]
    },
    "views": {
      "relay": [
        {
          "type": "webview",
          "id": "relay.tasks",
          "name": "Workspace Tasks",
          "contextualTitle": "Relay"
        }
      ]
    },
    "commands": [
      {
        "command": "relay.openPlan",
        "title": "Relay: Open Rebuild Plan"
      },
      {
        "command": "relay.refresh",
        "title": "Relay: Refresh Workspace"
      },
      {
        "command": "relay.connectNativeCodex",
        "title": "Relay: Connect Native Codex"
      },
      {
        "command": "relay.connectNativeClaude",
        "title": "Relay: Connect Native Claude Code"
      },
      {
        "command": "relay.connectNativeBob",
        "title": "Relay: Connect Native IBM Bob"
      },
      {
        "command": "relay.disconnectProvider",
        "title": "Relay: Disconnect an Agent"
      },
      {
        "command": "relay.traceFlowFromHere",
        "title": "Relay: Trace Flow from Here"
      },
      {
        "command": "relay.prepareSemantic",
        "title": "Relay: Prepare Local Semantic Search"
      },
      {
        "command": "relay.indexWorkspace",
        "title": "Relay: Index Workspace Knowledge"
      },
      {
        "command": "relay.exportReport",
        "title": "Relay: Export Implementation Report"
      }
    ],
    "configuration": {
      "title": "Relay Companion",
      "properties": {
        "relay.nodeExecutable": {
          "type": "string",
          "default": "node",
          "scope": "machine",
          "description": "Node.js 24+ executable for the isolated workspace service. Native provider executables are not launched by Relay."
        },
        "relay.flowDepth": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 12,
          "scope": "resource",
          "description": "Default call-hop depth for source flow diagrams."
        },
        "relay.pythonExecutable": {
          "type": "string",
          "default": "python",
          "scope": "machine",
          "description": "Python 3.10+ executable for isolated AST source-flow analysis. Workspace code is parsed, never imported or executed."
        },
        "relay.checks": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "description": "Independent check recipes runnable by connected native agents. Commands execute trusted workspace code. Use executable and argument arrays, without shell fragments.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "executable",
              "args"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              "name": {
                "type": "string"
              },
              "executable": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 1800000
              }
            }
          }
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "relay.traceFlowFromHere",
          "when": "editorTextFocus",
          "group": "navigation@20"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare:debug": "npm run build && node scripts/prepare-debug.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && node scripts/preview.mjs",
    "test": "node --import tsx --test tests/core/*.test.ts tests/integration/*.test.ts tests/analysis/*.test.ts",
    "test:ui": "playwright test",
    "test:host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/host-smoke.ps1",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "prepare:semantic": "node scripts/prepare-embeddings.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:ui",
    "package:vsix": "npm run build && node scripts/licenses.mjs && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links --skip-license -o artifacts/relay-workspace-0.2.2.vsix",
    "format": "prettier --write src tests scripts docs README.md package.json tsconfig.json playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.12",
    "prettier": "3.6.2",
    "tsx": "^4.20.6"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "typescript": "^5.9.3",
    "zod": "4.6.7"
  }
}
