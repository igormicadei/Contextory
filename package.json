{
  "name": "contextory-workspace",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.9.0",
  "publisher": "contextory-local",
  "icon": "media/contextory-icon.png",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/igormicadei/Contextory.git"
  },
  "homepage": "https://github.com/igormicadei/Contextory#readme",
  "bugs": {
    "url": "https://github.com/igormicadei/Contextory/issues"
  },
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=24.0.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:contextory.tasks",
    "*"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextory",
          "title": "%contributes.viewsContainers.activitybar.0.title%",
          "icon": "media/contextory.svg"
        }
      ]
    },
    "views": {
      "contextory": [
        {
          "type": "webview",
          "id": "contextory.tasks",
          "name": "%contributes.views.contextory.0.name%",
          "contextualTitle": "%contributes.views.contextory.0.contextualTitle%"
        }
      ]
    },
    "commands": [
      {
        "command": "contextory.restartAgentExtensions",
        "title": "%command.contextory.restartAgentExtensions.title%"
      },
      {
        "command": "contextory.checkConnections",
        "title": "%command.contextory.checkConnections.title%"
      },
      {
        "command": "contextory.rebuildHooks",
        "title": "%command.contextory.rebuildHooks.title%"
      },
      {
        "command": "contextory.connectGenericMcp",
        "title": "%command.contextory.connectGenericMcp.title%"
      },
      {
        "command": "contextory.openArchitecture",
        "title": "%command.contextory.openArchitecture.title%"
      },
      {
        "command": "contextory.toggleAutoConnect",
        "title": "%command.contextory.toggleAutoConnect.title%"
      },
      {
        "command": "contextory.openPlan",
        "title": "%command.contextory.openPlan.title%"
      },
      {
        "command": "contextory.refresh",
        "title": "%command.contextory.refresh.title%"
      },
      {
        "command": "contextory.connectNativeCodex",
        "title": "%command.contextory.connectNativeCodex.title%"
      },
      {
        "command": "contextory.connectNativeClaude",
        "title": "%command.contextory.connectNativeClaude.title%"
      },
      {
        "command": "contextory.connectNativeBob",
        "title": "%command.contextory.connectNativeBob.title%"
      },
      {
        "command": "contextory.disconnectProvider",
        "title": "%command.contextory.disconnectProvider.title%"
      },
      {
        "command": "contextory.traceFlowFromHere",
        "title": "%command.contextory.traceFlowFromHere.title%"
      },
      {
        "command": "contextory.prepareSemantic",
        "title": "%command.contextory.prepareSemantic.title%"
      },
      {
        "command": "contextory.indexWorkspace",
        "title": "%command.contextory.indexWorkspace.title%"
      },
      {
        "command": "contextory.exportReport",
        "title": "%command.contextory.exportReport.title%"
      }
    ],
    "configuration": {
      "title": "%contributes.configuration.title%",
      "properties": {
        "contextory.autoConnect": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%contributes.configuration.properties.contextory.autoConnect.description%"
        },
        "contextory.startupAgent": {
          "type": "string",
          "enum": [
            "auto",
            "last-used",
            "codex",
            "claude",
            "bob",
            "none"
          ],
          "enumDescriptions": [
            "%contributes.configuration.properties.contextory.startupAgent.enumDescriptions.0%",
            "%contributes.configuration.properties.contextory.startupAgent.enumDescriptions.1%",
            "%contributes.configuration.properties.contextory.startupAgent.enumDescriptions.2%",
            "%contributes.configuration.properties.contextory.startupAgent.enumDescriptions.3%",
            "%contributes.configuration.properties.contextory.startupAgent.enumDescriptions.4%",
            "%contributes.configuration.properties.contextory.startupAgent.enumDescriptions.5%"
          ],
          "default": "auto",
          "scope": "resource",
          "description": "%contributes.configuration.properties.contextory.startupAgent.description%"
        },
        "contextory.nodeExecutable": {
          "type": "string",
          "default": "node",
          "scope": "machine",
          "description": "%contributes.configuration.properties.contextory.nodeExecutable.description%"
        },
        "contextory.restartAfterSetup": {
          "type": "string",
          "enum": [
            "prompt",
            "automatic",
            "never"
          ],
          "default": "prompt",
          "scope": "resource",
          "description": "%contributes.configuration.properties.contextory.restartAfterSetup.description%"
        },
        "contextory.flowDepth": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 12,
          "scope": "resource",
          "description": "%contributes.configuration.properties.contextory.flowDepth.description%"
        },
        "contextory.pythonExecutable": {
          "type": "string",
          "default": "python",
          "scope": "machine",
          "description": "%contributes.configuration.properties.contextory.pythonExecutable.description%"
        },
        "contextory.checks": {
          "type": "array",
          "maxItems": 256,
          "default": [],
          "scope": "resource",
          "description": "%contributes.configuration.properties.contextory.checks.description%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "executable",
              "args"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              "name": {
                "type": "string"
              },
              "executable": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 1800000
              }
            }
          }
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "contextory.traceFlowFromHere",
          "when": "editorTextFocus",
          "group": "navigation@20"
        }
      ]
    }
  },
  "scripts": {
    "skills:package": "node scripts/package-skills.mjs",
    "skills:check": "node scripts/package-skills.mjs --check",
    "skills:sync": "npm run skills:package && node --import tsx scripts/sync-workspace-skills.ts",
    "skills:workspace-check": "npm run skills:check && node --import tsx scripts/sync-workspace-skills.ts --check",
    "build": "node scripts/build.mjs",
    "icons:render": "node scripts/render-icons.mjs",
    "prepare:debug": "npm run build && node scripts/prepare-debug.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && node scripts/preview.mjs",
    "test": "node --import tsx --test tests/core/*.test.ts tests/integration/*.test.ts tests/analysis/*.test.ts",
    "test:ui": "playwright test",
    "test:host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/host-smoke.ps1",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "evaluate:codebase": "node --import tsx scripts/evaluate-codebase.ts",
    "prepare:semantic": "node scripts/prepare-embeddings.mjs",
    "check": "npm run i18n:check && npm run skills:check && npm run typecheck && npm run build && npm test && npm run test:ui",
    "package:vsix": "npm run docs:build && npm run docs:integrations && npm run build && node scripts/licenses.mjs && node scripts/package-vsix.mjs",
    "format": "prettier --write src tests scripts docs README.md package.json tsconfig.json playwright.config.ts",
    "docs:build": "node scripts/docs.mjs",
    "docs:preview": "node scripts/docs.mjs preview",
    "docs:map": "node scripts/docs.mjs map",
    "docs:migrate": "node scripts/docs.mjs migrate",
    "docs:validate": "node scripts/docs.mjs validate",
    "docs:check": "npm run docs:validate && npm run docs:build && node --test tests/documentation/site.test.mjs",
    "docs:integrations": "node scripts/docs.mjs integrations",
    "release:verify": "node scripts/verify-release.mjs",
    "i18n:check": "node scripts/check-localization.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.12",
    "prettier": "3.6.2",
    "tsx": "^4.20.6"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "typescript": "^5.9.3",
    "zod": "4.6.7"
  }
}
